      "actions_path": "actions.json"
    }
  },
  "rcc": {
    "plugin": "rveval.governance.passthrough:PassThroughRCC",
    "config": {}
  },
  "veritas": {
    "plugin": "rveval.governance.passthrough:AllowAllVeritas",
    "config": {}
  },
  "policy": {
    "max_steps": 4,
    "on_governance_stop": "terminate"
  },
  "pins": {
    "purpose": "example only; replace with exact benchmark/model/RCC/VERITAS pins before external validation"
  }
