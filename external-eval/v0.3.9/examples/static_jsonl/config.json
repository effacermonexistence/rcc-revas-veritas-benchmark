{
  "run_mode": "dual",
  "seed": 7,
  "benchmark": {
    "plugin": "rveval.adapters.static_jsonl:StaticJSONLAdapter",
    "config": {
      "name": "example-static",
      "cases_path": "cases.jsonl",
      "labels_path": "labels.jsonl"
    }
  },
  "agent": {
    "plugin": "rveval.agents.replay:ReplayAgent",
