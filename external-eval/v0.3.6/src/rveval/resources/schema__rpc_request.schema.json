{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RPC request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "op",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "rveval.rpc.v2"
    },
    "request_id": {
      "type": "string"
    },
    "op": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
