{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rveval.native-scores.v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "COMPLETED"
    },
    "scored_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "arms": {
      "const": [
        "A",
        "B"
      ]
    },
    "native_score_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "request_sha256",
    "status",
    "scored_case_ids",
    "arms",
    "native_score_files"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
